{
  "name": "qazan-ai-trading-pro-max",
  "private": false,
  "version": "1.0.0",
  "description": "Open-source intelligent trading and market analysis platform powered by React, TypeScript, FastAPI, SQLite, TradingView Lightweight Charts, and local ML.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "backend:test": "python3 -m pytest backend/tests -v",
    "test": "npm run lint && npm run build && npm run backend:test",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:bundle:release": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "backup:zip": "python3 scripts/create_project_backup.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.1",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
