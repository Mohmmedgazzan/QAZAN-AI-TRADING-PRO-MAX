# ==============================================================================
# QAZAN-AI-TRADING-PRO-MAX — Open Source Environment Template
# Copy to .env (`cp .env.example .env`) and adjust values for your environment.
# NEVER commit .env files, private keys, or Android keystores to Git.
# ==============================================================================

# --- Gateway / Node Server (server.ts) ---
NODE_ENV="development"
PORT="3000"
QAZAN_BACKEND_HOST="127.0.0.1"
QAZAN_BACKEND_PORT="8001"
DISABLE_HMR="false"

# --- FastAPI Backend ---
APP_ENV="development"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8001"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# SQLite Database Path (relative to backend/ or absolute path)
SQLITE_DB_PATH="data/qazan_trading.db"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost,https://localhost"

# --- Free Keyless Public Market Data Endpoints (No API Keys Required) ---
# Tip: If api.binance.com is geo-restricted in your region, use https://data-api.binance.vision
MARKET_DATA_BASE_URL="https://api.binance.com"
FUTURES_DATA_BASE_URL="https://fapi.binance.com"
OKX_PUBLIC_BASE_URL="https://www.okx.com"
COINGECKO_BASE_URL="https://api.coingecko.com"
COINPAPRIKA_BASE_URL="https://api.coinpaprika.com"
BINANCE_SPOT_WS_URL="wss://stream.binance.com:9443/stream"
BINANCE_FUTURES_WS_URL="wss://fstream.binance.com/ws/!forceOrder@arr"
MARKET_DATA_TIMEOUT_SEC="8.0"
ENABLE_BACKGROUND_WS="true"

# --- Frontend (Vite) ---
# Keep "/api/v1" when serving behind Gateway/Nginx/Docker; set full HTTPS URL for standalone mobile builds
VITE_API_BASE_URL="/api/v1"
# Default HTTPS origin baked into Capacitor Android builds (can be overridden in Settings UI)
VITE_QAZAN_NATIVE_BACKEND_ORIGIN="https://localhost:8001"

# --- Optional Android Release Signing (Keep values ONLY in local shell / CI Secrets) ---
# QAZAN_KEYSTORE_FILE="/path/to/qazan-release.keystore"
# QAZAN_KEYSTORE_PASSWORD=""
# QAZAN_KEY_ALIAS="qazan_release"
# QAZAN_KEY_PASSWORD=""
